{
  "openapi": "3.1.0",
  "info": {
    "title": "Vértice AI Fase II",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/model": {
      "get": {
        "summary": "Model",
        "operationId": "model_v1_model_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_v1_predict_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/clients": {
      "get": {
        "summary": "Get Clients",
        "operationId": "get_clients_v1_clients_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/scenario": {
      "post": {
        "summary": "Scenario",
        "operationId": "scenario_v1_scenario_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Input": {
        "properties": {
          "texto": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 3,
            "title": "Texto"
          },
          "idioma": {
            "type": "string",
            "const": "en",
            "title": "Idioma",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "texto"
        ],
        "title": "Input"
      },
      "Scenario": {
        "properties": {
          "cliente_id": {
            "type": "string",
            "pattern": "^C\\d{3}$",
            "title": "Cliente Id"
          },
          "proporcion": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Proporcion"
          },
          "mejora_anual_pp": {
            "type": "number",
            "maximum": 100.0,
            "minimum": -100.0,
            "title": "Mejora Anual Pp"
          },
          "meses": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Meses"
          },
          "gastos_adicionales_anuales_pp": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Gastos Adicionales Anuales Pp"
          },
          "perfil_destino": {
            "type": "string",
            "enum": [
              "Conservador",
              "Moderado",
              "Agresivo"
            ],
            "title": "Perfil Destino"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cliente_id",
          "proporcion",
          "mejora_anual_pp",
          "meses",
          "gastos_adicionales_anuales_pp",
          "perfil_destino"
        ],
        "title": "Scenario"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
